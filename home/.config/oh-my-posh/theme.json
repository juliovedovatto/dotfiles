{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#303030",
          "foreground": "#B2B4B6",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} <#626262>\ue0b1</>",
          "type": "os"
        },
        {
          "background": "#303030",
          "foreground": "#626262",
          "style": "plain",
          "template": " \uf0e7 ",
          "type": "root"
        },
        {
          "background": "#303030",
          "foreground": "#1486AC",
          "type": "path",
          "style": "powerline",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "folder_separator_icon": "",
            "home_icon": "~",
            "mapped_locations": {
              "~": "\uf46d ~",
              "~/*": "\uf07c ~"
            },
            "max_depth": 2
          }
        },
        {
          "background": "#303030",
          "foreground": "#6CA35E",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFD866{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": "<#626262>\ue0b1 </> {{ if .IsWorkTree }}<#6CA35E>\uDB85\uDE0E ({{ base .Dir }}) </>{{ end }}{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "git"
        },
        {
          "background": "transparent",
          "foreground": "#303030",
          "style": "plain",
          "template": "\ue0b0",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#64AE2E",
          "background": "#303030",
          "foreground_templates": ["{{ if gt .Code 0 }}#E53935{{ end }}"],
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "options": {
            "always_enabled": true
          },
          "template": " {{ if eq .Code 0 }}\uf00c{{ else }}\uf00d {{ .Code }}{{ end }} ",
          "type": "status"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#A8A8A8",
          "background": "#303030",
          "template": " \ue0b3 {{ .FormattedMs }} \uf252 ",
          "options": {
            "always_enabled": false
          }
        },
        {
          "background": "#303030",
          "foreground": "#6CA35E",
          "options": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": "<#626262>\ue0b3</> \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "type": "python",
          "style": "powerline",
          "foreground": "#906cff",
          "background": "#303030",
          "options": {
            "display_mode": "context"
          },
          "template": "<#626262>\ue0b3</> \ue235 {{ .Full }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#B2B4B6",
          "style": "plain",
          "template": "\u276f ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
